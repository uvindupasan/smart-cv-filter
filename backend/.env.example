# ============================================
# Smart CV Filter — Backend Environment Config
# ============================================

# MongoDB connection string
# Local:  mongodb://localhost:27017/smart_cv_filter
# Cloud:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/smart_cv_filter
MONGO_URI=mongodb://localhost:27017/smart_cv_filter

# JWT secret — change this to any long random string
JWT_SECRET=your_super_secret_jwt_key_change_this_123456

# JWT expiry
JWT_EXPIRES_IN=7d

# Port for backend server
PORT=5000

# AI Service URL (Python FastAPI)
AI_SERVICE_URL=http://localhost:8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
